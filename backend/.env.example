# ============================================================
# TeleMed - backend/.env.example
# Konfigurasi environment aplikasi backend mengacu pada root .env.example
# ============================================================

# Database PostgreSQL
PGHOST=db
PGPORT=5432
PGUSER=telemed_admin
PGPASSWORD=medisync2026
PGDATABASE=telemed
PG_POOL_MAX=10

# Keamanan & JWT
# JWT_SECRET wajib diisi dan minimal 32 karakter (contoh: openssl rand -hex 32)
JWT_SECRET=ISI_SECRET_MINIMAL_32_KARAKTER_HEX_ATAU_STRING
JWT_EXPIRES=8h

# CORS & Seed
CORS_ORIGIN=http://localhost:8080
SEED_PASSWORD=medisync2026
APP_ENV=production
