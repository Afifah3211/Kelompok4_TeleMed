# ============================================================
# MediSync Backend - Environment Variables Template
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke repository!
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database (Docker Volume path) ───────────────────────────
# Lokal:  tidak perlu diisi (default ke backend/db/medisync.db)
# Docker: diisi otomatis oleh docker-compose.yml
DB_PATH=/app/db/data/medisync.db

# ── Backup & Recovery ────────────────────────────────────────
BACKUP_DIR=/app/backups
RECOVERY_DIR=/app/recovery
