# ============================================================
# TeleMed - Crontab Jadwal Backup Otomatis
# ============================================================
# 1. Dump logis tiap 6 jam (00:00, 06:00, 12:00, 18:00 WIB)
0 0,6,12,18 * * * /scripts/dump_logis.sh >> /proc/1/fd/1 2>&1

# 2. Base backup harian pukul 01:00 WIB
0 1 * * * /scripts/base_backup.sh >> /proc/1/fd/1 2>&1

# 3. Sinkronisasi enkripsi WAL ke Off-site tiap 5 menit
*/5 * * * * /scripts/sync_offsite.sh >> /proc/1/fd/1 2>&1

# 4. Pembersihan retensi (lokal 7 hari, offsite 30 hari) tiap pukul 02:00 WIB
0 2 * * * /scripts/cleanup.sh >> /proc/1/fd/1 2>&1

# 5. Pemeriksaan harian integritas backup tiap pukul 06:30 WIB
30 6 * * * /scripts/check_daily.sh >> /proc/1/fd/1 2>&1

