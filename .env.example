# ============================================================
# TeleMed - .env.example   (salin jadi .env, ISI, JANGAN di-commit)
# Catatan: nilai PG* harus SAMA dengan POSTGRES_* (compose tidak
# meng-interpolasi variabel di dalam env_file, jadi ditulis dobel).
# ============================================================

# --- PostgreSQL (container db) ---
POSTGRES_USER=telemed_admin
POSTGRES_PASSWORD=medisync2026
POSTGRES_DB=telemed

# --- Koneksi backend & backup ke db (samakan dengan di atas) ---
PGHOST=db
PGPORT=5432
PGUSER=telemed_admin
PGPASSWORD=medisync2026
PGDATABASE=telemed
PG_POOL_MAX=10

# --- Backend ---
NODE_ENV=production
PORT=5000
JWT_SECRET=ISI_HASIL_openssl_rand_-hex_32
JWT_EXPIRES=8h
CORS_ORIGIN=http://localhost:8080
SEED_PASSWORD=medisync2026

# --- Backup (kunci AES-256 ada di secrets/backup_key.txt, BUKAN di sini) ---

# --- MinIO / File Storage CDN ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=telemed-files
MINIO_PUBLIC_HOST=http://localhost:9000
MINIO_USE_SSL=false
